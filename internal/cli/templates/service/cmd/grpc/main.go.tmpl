package main

import (
	f "github.com/foundation-go/foundation"

	"google.golang.org/grpc"
)

func main() {
	svc := f.InitGRPCServer("{{.ShortName}}")

	opts := f.NewGRPCServerOptions()

	// Register the gRPC services generated from your protobuf definitions:
	//
	//	pb.Register{{.ShortName | Title}}Server(s, &{{.ShortName}}Server{})
	opts.RegisterFunc = func(s *grpc.Server) {}

	// Components the service needs. Add f.WithKafkaProducer(), f.WithOutbox(),
	// f.WithRedis() and so on as they become relevant.
	opts.StartComponentsOptions = []f.StartComponentsOption{}

	svc.Start(opts)
}
